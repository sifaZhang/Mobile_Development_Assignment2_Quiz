<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".player.TournamentDetailActivity"
    android:id="@+id/main">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header -->
        <include
            layout="@layout/layout_common_header"
            android:id="@+id/header" />

        <LinearLayout
            style="@style/InnerLayout">

            <TextView
                android:id="@+id/tvName"
                style="@style/SectionTitle"
                android:textSize="28sp"
                android:text="Tournament Name"
                android:layout_marginBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvCategory"
                android:text="Category: Music"
                style="@style/TextStyle4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvDifficulty"
                android:text="Difficulty: Easy"
                style="@style/TextStyle4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvCount"
                android:text="Question Count: 10"
                style="@style/TextStyle4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvDates"
                android:text="Date: 01-01-2026 - 03-03-2026"
                style="@style/TextStyle4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvRatingCount"
                android:text="Rating Count: 10"
                style="@style/TextStyle4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <RatingBar
                android:id="@+id/ratingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:isIndicator="true"
                android:numStars="5"
                android:stepSize="0.5"
                android:padding="0dp"
                android:scaleX="0.6"
                android:scaleY="0.6"
                android:translationX="-46dp" />

            <Button
                android:id="@+id/btnJoin"
                android:text="Join Tournament"
                style="@style/AppButtonPrimaryStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>